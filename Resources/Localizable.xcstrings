    "Low Power Mode is on. GPS updates may be reduced; charge or turn it off for long drives.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low Power Mode is on. GPS updates may be reduced; charge or turn it off for long drives."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低電力モードがオンです。GPS の更新が減る場合があります。長距離ドライブでは充電するかオフにしてください。"
          }
        }
      }
    },
