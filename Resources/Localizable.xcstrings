    "Location access is off. DriveScope needs it to record your route and speed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is off. DriveScope needs it to record your route and speed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報の利用がオフです。ルートと速度を記録するには DriveScope に位置情報の許可が必要です。"
          }
        }
      }
    },
