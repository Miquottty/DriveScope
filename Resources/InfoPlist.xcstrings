{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DriveScope"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DriveScope"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DriveScope uses your location in the background to reopen and continue a recording that was interrupted mid-drive (robust mode)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "走行中に記録が中断されたとき、DriveScope を再度開いて記録を続けるために、バックグラウンドで位置情報を使用します（堅牢モード）。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DriveScope records your route, speed and altitude while you drive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DriveScope は運転中のルート、速度、高度を記録します。"
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DriveScope records acceleration and attitude to measure g-forces."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DriveScope は加速度と姿勢を記録して、Gを計測します。"
          }
        }
      }
    }
  },
  "version": "1.0"
}